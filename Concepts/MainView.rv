use ui as std.ui;

struct MainView : View {
    var body: some View {
        TabView {
            InfoPage
            .tabitem(name: "Info")  // if the bounds are too small the default systemImage will be displayed
            // default systemImage: "globe"

            SettingsView
            .tabitem(label: {
                Label(text: "Settings", systemImage: "gear.fill")
            })

            InfoPage // gets a default name "Tab \{x}" -> "Tab 3"
        }
    }
}
